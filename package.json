{
  "name": "@lab-anssi/ui-kit",
  "version": "2.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/betagouv/lab-anssi-ui-kit.git"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/betagouv/lab-anssi-ui-kit/issues"
  },
  "homepage": "https://github.com/betagouv/lab-anssi-ui-kit#readme",
  "engines": {
    "node": ">=26.13.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.17.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "svelte-package && pnpm run build:styles:icons && pnpm run build:manifest && pnpm run build:webcomponents && pnpm run copy:icons && publint",
    "build:tokens": "node src/tokens/build.config.ts && pnpm prettier -w .storybook/lab-anssi-themes.css",
    "build:webcomponents": "vite -c vite.webcomponents.config.ts build",
    "build:styles:dsfr": "sass src/lib/styles/dsfr-variables.scss dist/assets/dsfr-variables.css -I node_modules -I node_modules/@gouvfr/dsfr --no-source-map",
    "build:styles:icons": "node scripts/build-dsfr-icons.mjs",
    "build:manifest": "node scripts/generate-ui-manifest.mjs",
    "prepare": "husky",
    "check": "UI_KIT_CHECK=1 svelte-check --tsconfig ./tsconfig.check.json --threshold error",
    "prepack": "publint",
    "test": "vitest run",
    "storybook:dev": "STORYBOOK_ENV=development storybook dev -p 6006",
    "storybook:build": "STORYBOOK_ENV=production storybook build",
    "storybook:build-dev": "STORYBOOK_ENV=development storybook build",
    "test-storybook": "vitest --project=storybook",
    "copy:icons": "cp -r node_modules/@gouvfr/dsfr/dist/icons/* src/lib/assets/icones/dsfr && cp -r src/lib/assets/ dist/",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./dist/webcomponents": {
      "types": "./dist/webcomponents/lab-anssi-ui-kit.jsx.d.ts",
      "import": "./dist/webcomponents/lab-anssi-ui-kit.iife.js"
    },
    "./dist/assets/*": "./dist/assets/*",
    "./web-types.json": "./dist/web-types.json"
  },
  "web-types": "./dist/web-types.json",
  "peerDependencies": {
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "~5.6.0",
    "@eslint/compat": "~2.1.1",
    "@eslint/js": "~10.0.1",
    "@fullhuman/postcss-purgecss": "~8.0.0",
    "@gouvfr/dsfr": "1.14.4",
    "@storybook/addon-a11y": "~10.6.5",
    "@storybook/addon-docs": "~10.6.5",
    "@storybook/addon-svelte-csf": "~5.1.6",
    "@storybook/addon-themes": "~10.6.5",
    "@storybook/addon-vitest": "~10.6.5",
    "@storybook/svelte-vite": "~10.6.5",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "~7.3.1",
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/svelte": "~5.4.2",
    "@types/node": "~26.6.6",
    "@vitest/browser": "~4.1.12",
    "@vitest/browser-playwright": "~4.1.12",
    "@vitest/coverage-v8": "~4.1.12",
    "cssnano": "~9.9.0",
    "dotenv": "~18.0.9",
    "eslint": "~10.14.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-storybook": "~10.6.6",
    "eslint-plugin-svelte": "~3.24.1",
    "globals": "~17.14.0",
    "husky": "~9.1.7",
    "lint-staged": "~17.6.0",
    "playwright": "~1.64.1",
    "postcss": "~8.5.32",
    "postcss-discard-empty": "~9.0.8",
    "postcss-root-to-host": "~0.0.0",
    "prettier": "~3.9.10",
    "prettier-plugin-svelte": "~4.1.1",
    "publint": "~0.3.25",
    "sass": "~1.107.1",
    "storybook": "~10.6.5",
    "style-dictionary": "^5.7.1",
    "svelte": "~5.57.3",
    "svelte-check": "~4.7.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.1",
    "vite": "~8.3.5",
    "vitest": "~4.1.12"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": "eslint --cache --fix",
    "*.{js,ts,svelte,css,md,yml}": "prettier --write"
  }
}
